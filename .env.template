# FInsight Trading Engine — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# .env is NEVER committed to Git.

# ── Database ──────────────────────────────────────────────────────────────────
# For SQLite (local dev/prod):
DATABASE_URL=sqlite:///./finsight.db

# For MySQL (optional):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/finsight

# ── Zerodha Kite API ──────────────────────────────────────────────────────────
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_ACCESS_TOKEN=your_access_token_here  # Refreshed daily via Kite login flow

# ── NSE Data ──────────────────────────────────────────────────────────────────
NSE_BASE_URL=https://www.nseindia.com

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production        # 'development' | 'production'
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
ACCOUNT_EQUITY=1000000    # Total account equity in ₹ (updated manually when it changes)

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
